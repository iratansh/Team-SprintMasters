# Paste your Backboard key into backend/.env, never into source code.
BACKBOARD_API_KEY=

# Optional: set BOTH values, or leave BOTH empty to use Backboard's defaults.
BACKBOARD_LLM_PROVIDER=
BACKBOARD_MODEL_NAME=

# Maximum time to wait for a single API test (seconds, greater than 0, at most 120).
BACKBOARD_TIMEOUT_SECONDS=30
