# Paste your Backboard key into backend/.env, never into source code.
BACKBOARD_API_KEY=

# Optional: set BOTH values, or leave BOTH empty to use Backboard's defaults.
BACKBOARD_LLM_PROVIDER=
BACKBOARD_MODEL_NAME=

# Maximum time to wait for a single API test (seconds, greater than 0, at most 120).
BACKBOARD_TIMEOUT_SECONDS=30

# Existing ElevenLabs agent + Twilio number linked in ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# This is the ElevenLabs linked phone-number ID, NOT a Twilio SID or phone number.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_TIMEOUT_SECONDS=30

# Disabled by default. Real calls also require confirm_call=true in the request.
ELEVENLABS_ALLOW_OUTBOUND_CALLS=false
